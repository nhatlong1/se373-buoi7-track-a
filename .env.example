# Supported LLM_API_MODE: UIT, OpenAI Chat Completions

LLM_API_MODE=OpenAI Chat Completions
LLM_API_BASEURL=http://ai
LLM_API_PATH=/v1/chat/completions
LLM_API_MODEL=vercel/minimax/minimax-m3.1-flash
LLM_API_KEY=none
LLM_API_MAX_TOKENS=65536

# UIT Configuration
# LLM_API_MODE=UIT
# LLM_API_BASEURL=https://llm.uit.edu.vn/gemma # To use Qwen3.8-27b, replace /gemma with /qwen
# LLM_API_PATH=/v1/chat/completions
# LLM_API_MODEL=gemma-4-26b # Consult the ${LLM_API_BASEURL}/v1/models for the exact model ids.
# LLM_API_KEY=sk-uit-...

# UIT LLM server lacks tool parsing flags required for both automatic tool calling *and* tool syntax parsing.
# This implementation attempts to brute-force tool calling by system prompt injection.
#
# In UIT mode, the chat model specially disables tool calling and injects the tool list into the system prompt alongside an instruction
# on how to call tools (syntax) and the model will return tool calls as raw text inside their response. The chat model then makes an
# attempt to parse and extract the tool text and craft a "normal" response before handing back to the agent system.
# Even though the models hosted are fully open-weight models with publicly available Jinja template, we have made no attempt to reference
# their respective official Jinja template and instead guessed based on whatever Gemini 3.8 Flash remembers about Gemma and Qwen tool
# calling syntax. We make no guarantee the middleware works as well as a properly configured inference server. However, as far as our tests
# concern, the middleware is working perfectly as expected.
#
# THE MIDDLEWARE IS PROVIDED AS-IS, WITH NO GUARANTEE, EXPRESS OR IMPLIED,
# INCLUDING BUT NOT LIMITED TO: WORKING AT ALL, FITNESS FOR A PARTICULAR
# PURPOSE, AND MARCHANTABILITY.
